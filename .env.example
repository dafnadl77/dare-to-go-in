# Server-side only — never prefix with VITE_, never read via import.meta.env.
# Copy this file to .env and fill in your real key. .env is gitignored.
OPENAI_API_KEY=your_key_here

# Optional — defaults to a cost-efficient model if unset.
OPENAI_MODEL=gpt-4o-mini
# Optional: a model used ONLY by the dream-analysis route (structure + concepts). Leave unset in production: it then uses OPENAI_MODEL. Falls back to OPENAI_MODEL when unset.
# OPENAI_ANALYSIS_MODEL=

# Optional — port the local Dream Analysis backend listens on. If you
# change this, also update DREAM_ANALYSIS_BACKEND_PORT in vite.config.ts
# so the frontend's /api proxy still points at the right port.
DREAM_ANALYSIS_PORT=8787

# Supabase — public-by-design (anon/publishable key, safe for client
# code; access is enforced by Row Level Security, not by keeping this
# secret). VITE_ prefix required so Vite exposes it to the browser.
# Never put a service-role/secret key here or behind a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here

# Server-side only — never prefix with VITE_, never import anything under
# src/ that reads it. Powers the anonymous trial-identity and per-dream
# usage-limit tables (server/supabaseServiceClient.ts) — get it from
# Supabase Dashboard -> Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# REQUIRED IN PRODUCTION — the dedicated secret (32+ random characters) that signs the
# anonymous trial cookie (server/trialIdentity.ts). There is NO fallback to any other
# credential: if it is missing on Vercel, trial-session creation fails closed. Generate
# with e.g. `openssl rand -base64 48`. Local dev works without it (random per-process secret).
DARE_TRIAL_COOKIE_SECRET=

# Optional — the anonymous "first dream free" rule (server/trialAllowance.ts). ONE completed
# free dream per trial identity, for life; up to DARE_TRIAL_MAX_ATTEMPTS technical attempts
# (default 3) before it completes; DARE_TRIAL_MAX_TRANSCRIPTIONS voice recordings per
# identity (default 8); and a global emergency breaker, DARE_ANON_MAX_ATTEMPTS_PER_DAY
# (default 150) — total anonymous attempts started across ALL identities in a rolling 24h.
# Signed-in accounts are not restricted by any of these.
# DARE_TRIAL_MAX_ATTEMPTS=3
# DARE_TRIAL_MAX_TRANSCRIPTIONS=8
DARE_ANON_MAX_ATTEMPTS_PER_DAY=10

# Optional — EMERGENCY BACKSTOP ONLY: new trial identities allowed site-wide per
# rolling hour, counted on trial_identities.created_at. Default 1000. It is not a
# defence against cookie deletion (and can be exhausted on purpose to block real
# visitors); it only caps the damage if minting is being scripted at volume.
DARE_TRIAL_MINT_BACKSTOP_PER_HOUR=1000

# Payments (Grow through Make) - server-side only, never VITE_-prefixed, never committed.
# The Make "Custom webhook" URL of the scenario that creates the Grow payment link. It is a SECRET: whoever holds it can
# start the scenario. Must be an https hook.*.make.com address. Set it in .env locally and in Vercel -> Settings ->
# Environment Variables (Production and Preview) - never paste it into chat or code.
MAKE_CHECKOUT_WEBHOOK_URL=
# Optional second lock: only if the Make webhook has "API key authentication" enabled (sent as the x-make-apikey header).
# MAKE_CHECKOUT_WEBHOOK_API_KEY=
# The public https address customers return to after paying. Defaults to https://daretogoin.com.
# PUBLIC_SITE_URL=https://daretogoin.com
# Optional: comma-separated Grow domains the payment link may point to (default: grow.link, grow.business, meshulam.co.il).
# GROW_PAYMENT_URL_HOSTS=

# Payment COMPLETION (Make -> DARE). The dedicated secret Make sends as 'Authorization: Bearer <secret>' to POST
# /api/payment-complete. At least 32 random characters (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Set the SAME value in Make (HTTP module header) and in Vercel; never paste it into chat. Without it the route refuses everything.
MAKE_COMPLETION_SECRET=
