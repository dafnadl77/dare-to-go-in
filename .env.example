# Server-side only — never prefix with VITE_, never read via import.meta.env.
# Copy this file to .env and fill in your real key. .env is gitignored.
OPENAI_API_KEY=your_key_here

# Optional — defaults to a cost-efficient model if unset.
OPENAI_MODEL=gpt-4o-mini

# Optional — port the local Dream Analysis backend listens on. If you
# change this, also update DREAM_ANALYSIS_BACKEND_PORT in vite.config.ts
# so the frontend's /api proxy still points at the right port.
DREAM_ANALYSIS_PORT=8787

# Supabase — public-by-design (anon/publishable key, safe for client
# code; access is enforced by Row Level Security, not by keeping this
# secret). VITE_ prefix required so Vite exposes it to the browser.
# Never put a service-role/secret key here or behind a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here
